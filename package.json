{
  "name": "dsh-session-organizer",
  "description": "会话文件夹（伴随模式）：在官方会话列表上叠加「移动到文件夹」菜单、行首徽标与管理弹窗。Session folders as a companion to the native sidebar for DeepSeek Harness.",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "workspace",
    "session",
    "folder",
    "organizer"
  ]
}